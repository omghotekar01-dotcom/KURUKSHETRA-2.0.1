# TrustKernel v1.4 production-oriented configuration
TRUSTKERNEL_ENV=development
TRUSTKERNEL_REQUIRE_API_KEY=0
TRUSTKERNEL_ALLOW_LEGACY_ACTOR_HEADER=1
TRUSTKERNEL_REQUIRE_POLICY_APPROVAL=0
TRUSTKERNEL_POLICY_FOUR_EYES=1
TRUSTKERNEL_CORS_ORIGINS=*

# Rotate all signing material before any production deployment.
TRUSTKERNEL_SESSION_SIGNING_KEY=change-me
TRUSTKERNEL_A2A_SIGNING_KEY=change-me
TRUSTKERNEL_POLICY_SIGNING_KEY=change-me
TRUSTKERNEL_EVIDENCE_SIGNING_KEY=change-me
TRUSTKERNEL_EVIDENCE_KEY_ID=local-hmac-sha256

TRUSTKERNEL_SESSION_TTL_SECONDS=3600
TRUSTKERNEL_A2A_MAX_SKEW=300
TRUSTKERNEL_RATE_LIMIT_PER_MINUTE=120
TRUSTKERNEL_DAILY_ACTION_QUOTA=100000
# Offline/demo default is memory. Production should use Redis with TLS.
TRUSTKERNEL_QUOTA_BACKEND=memory
# TRUSTKERNEL_REDIS_URL=rediss://user:password@redis.example:6379/0
TRUSTKERNEL_REDIS_QUOTA_PREFIX=trustkernel:quota
TRUSTKERNEL_REDIS_TIMEOUT_SECONDS=2
TRUSTKERNEL_REDIS_STARTUP_PING=1

# TRUSTKERNEL_DB_PATH=/absolute/path/to/trustkernel.db
# TRUSTKERNEL_DB_BACKEND=postgres
# TRUSTKERNEL_DATABASE_URL=postgresql://trustkernel:secret@localhost:5432/trustkernel
# PostgreSQL replicas serialize checksum-pinned schema migrations with a transaction-scoped advisory lock.
# Startup fails closed if migration ownership cannot be acquired within this bounded wait.
TRUSTKERNEL_MIGRATION_LOCK_TIMEOUT_MS=15000

# Enterprise OIDC/JWT human identity adapter.
# Discovery is used automatically from ISSUER unless a JWKS URL/static JWKS is supplied.
# TRUSTKERNEL_OIDC_ISSUER=https://idp.example.com
# TRUSTKERNEL_OIDC_AUDIENCE=trustkernel
# TRUSTKERNEL_OIDC_DISCOVERY_URL=https://idp.example.com/.well-known/openid-configuration
# TRUSTKERNEL_OIDC_JWKS_URL=https://idp.example.com/.well-known/jwks.json
# TRUSTKERNEL_OIDC_JWKS_JSON={"keys":[]}
TRUSTKERNEL_OIDC_WORKSPACE_CLAIM=workspace_id
TRUSTKERNEL_OIDC_EMAIL_CLAIM=email
TRUSTKERNEL_OIDC_ROLE_CLAIM=roles
TRUSTKERNEL_OIDC_DEFAULT_ROLE=viewer
# TRUSTKERNEL_OIDC_ROLE_MAP_JSON={"trustkernel-admin":"admin","trustkernel-security":"security_analyst"}
TRUSTKERNEL_OIDC_ALGORITHMS=RS256,ES256,EdDSA
TRUSTKERNEL_OIDC_JWKS_CACHE_SECONDS=300
TRUSTKERNEL_OIDC_CLOCK_SKEW_SECONDS=30
TRUSTKERNEL_OIDC_REQUIRE_HTTPS=1

# Optional OTLP export of TrustKernel security spans.
# Dependency-light compatibility path; plain HTTP is for local/demo collectors only.
# TRUSTKERNEL_OTLP_HTTP_ENDPOINT=http://127.0.0.1:4318/v1/traces
# Native OpenTelemetry SDK path. Signal-specific configuration has precedence:
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://otel-collector.example/v1/traces
# Standard global OTLP base endpoint is also supported and expands to /v1/traces:
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector.example
# When TRUSTKERNEL_ENV=production, configured OTLP export must use HTTPS.
# TRUSTKERNEL_OTLP_BEARER_TOKEN=
