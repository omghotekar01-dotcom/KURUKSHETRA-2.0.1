# TrustKernel v1.3 production-oriented configuration
TRUSTKERNEL_ENV=development
TRUSTKERNEL_REQUIRE_API_KEY=0
TRUSTKERNEL_ALLOW_LEGACY_ACTOR_HEADER=1
TRUSTKERNEL_REQUIRE_POLICY_APPROVAL=0
TRUSTKERNEL_POLICY_FOUR_EYES=1
TRUSTKERNEL_CORS_ORIGINS=*

# Rotate all three before any production deployment.
TRUSTKERNEL_SESSION_SIGNING_KEY=change-me
TRUSTKERNEL_A2A_SIGNING_KEY=change-me
TRUSTKERNEL_POLICY_SIGNING_KEY=change-me

TRUSTKERNEL_SESSION_TTL_SECONDS=3600
TRUSTKERNEL_A2A_MAX_SKEW=300
TRUSTKERNEL_RATE_LIMIT_PER_MINUTE=120
TRUSTKERNEL_DAILY_ACTION_QUOTA=100000
# TRUSTKERNEL_DB_PATH=/absolute/path/to/trustkernel.db

# Optional enterprise OIDC/JWT human identity adapter.
# When configured, normal Bearer JWTs are verified and normalized into the
# same workspace member/RBAC contract as TrustKernel's local signed sessions.
# TRUSTKERNEL_OIDC_ISSUER=https://idp.example.com
# TRUSTKERNEL_OIDC_AUDIENCE=trustkernel
# TRUSTKERNEL_OIDC_JWKS_URL=https://idp.example.com/.well-known/jwks.json
# TRUSTKERNEL_OIDC_JWKS_JSON={"keys":[]}
TRUSTKERNEL_OIDC_WORKSPACE_CLAIM=workspace_id
TRUSTKERNEL_OIDC_EMAIL_CLAIM=email
TRUSTKERNEL_OIDC_ALGORITHMS=RS256,ES256,EdDSA
TRUSTKERNEL_OIDC_JWKS_CACHE_SECONDS=300
